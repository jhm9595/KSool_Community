{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"ksool-community",
  "main":"server/worker.mjs",
  "compatibility_date":"2026-11-01",
  "assets":{"directory":"./dist","binding":"ASSETS","run_worker_first":["/api/*"]},
  "d1_databases":[{"binding":"DB","database_name":"ksool-community","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "vars":{"GAME_ORIGINS":"https://ksool.minibig.pw,https://play.ksool.minibig.pw"},
  "triggers":{"crons":["0 * * * *"]},
  "observability":{"enabled":false}
}
